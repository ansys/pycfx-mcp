{
  "id": "ansys-cfx-mcp",
  "name": "Ansys CFX Connector",
  "version": "1.0.0",
  "manifest_schema_version": 1,
  "package_format_version": 1,
  "platform": {
    "os": "windows",
    "arch": "x64"
  },
  "runtime": "python",
  "entry": "run_server.py",
  "min_app_version": "0.4.0",
  "entitlement_tier": "free",
  "port_env_var": "MCP_PORT",
  "token_env_var": "MCP_LICENSE_TOKEN",
  "stdio": true,
  "tool_tiers": {
    "core": [
      "cfx_workflow",
      "cfx_model_context",
      "run_code",
      "validate_code",
      "get_setup",
      "set_setup",
      "start_solve",
      "get_solve_status",
      "get_convergence_status",
      "stop_solve",
      "get_results",
      "evaluate_post_expression",
      "execute_ccl",
      "manage_expressions",
      "inspect_mesh",
      "screenshot",
      "find_api",
      "get_help"
    ],
    "relevance_floor": 5.5,
    "aliases_file": "src/ansys/cfx/mcp/aiconnect_aliases.json"
  },
  "tool_index": {
    "exec_tool": "run_code",
    "capabilities_file": "src/ansys/cfx/mcp/aiconnect-capabilities.json",
    "relevance_floor": 5.5
  },
  "package": {
    "include": [
      "run_server.py",
      "src",
      "manifest.json",
      "marketplace.json",
      "TUTORIAL.md",
      "assets",
      "scripts",
      "LICENSE"
    ],
    "exclude": [
      "scripts/package-acpkg.sh"
    ],
    "vendor": [
      "_vendor"
    ]
  },
  "platform_requirements": {
    "python": [
      "Python >= 3.10",
      "ansys-common-mcp (PyAnsysBaseMCP runtime)",
      "PyCFX sessions (bundled)"
    ],
    "windows": [
      "Ansys CFX installed (CFX-Pre, Solver, CFD-Post) for live sessions"
    ],
    "linux": [
      "PyCFX backend only (no GUI-dependent operations)"
    ]
  },
  "config": {
    "env": [
      {
        "key": "ANSYS_MCP_HOST",
        "label": "Ansys bridge host",
        "kind": "host",
        "secret": false,
        "required": false,
        "default": "127.0.0.1",
        "description": "Host running Ansys bridge."
      },
      {
        "key": "ANSYS_MCP_PORT",
        "label": "Ansys bridge port",
        "kind": "host",
        "secret": false,
        "required": false,
        "default": "48152",
        "description": "TCP port exposed by Ansys bridge."
      }
    ]
  },
  "tools": [
    {
      "name": "connect_cfx",
      "description": "Launch or connect to CFX-Pre session",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "launch",
              "connect"
            ]
          },
          "case_file": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_setup",
      "description": "Read full CFX settings tree",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "set_setup",
      "description": "Modify any CFX setting",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "save_case",
      "description": "Save .cfx case file",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "start_solve",
      "description": "Launch CFX-Solver with parallel partitions, double precision, and restart support",
      "inputSchema": {
        "type": "object",
        "properties": {
          "def_file": {
            "type": "string"
          },
          "partitions": {
            "type": "integer"
          },
          "parallel_mode": {
            "type": "string"
          },
          "double_precision": {
            "type": "boolean"
          },
          "initial_file": {
            "type": "string"
          }
        },
        "required": ["def_file"]
      }
    },
    {
      "name": "get_solve_status",
      "description": "Check solver run state",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "stop_solve",
      "description": "Stop solver run",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "get_results",
      "description": "Load CFD-Post results + query",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "disconnect_cfx",
      "description": "Exit CFX session",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "get_version",
      "description": "Query CFX engine version",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "list_cfx_api_categories",
      "description": "Browse CCL hierarchy categories",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "search_cfx_api",
      "description": "Search CCL parameters by keyword",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "query_cfx_registry",
      "description": "Look up parameter path + type + description",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "get_convergence_status",
      "description": "Parse live CFX-Solver residuals and domain conservation imbalances",
      "inputSchema": {
        "type": "object",
        "properties": {
          "max_history": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "evaluate_post_expression",
      "description": "Evaluate quantitative CEL expressions in CFX-Post (massFlowAve, areaAve, force, etc.)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string"
          }
        },
        "required": ["expression"]
      }
    },
    {
      "name": "execute_ccl",
      "description": "Inject multiline CCL blocks directly into CFX-Pre, Solver, or Post",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ccl": {
            "type": "string"
          },
          "session_type": {
            "type": "string",
            "enum": ["auto", "pre", "solver", "post"]
          }
        },
        "required": ["ccl"]
      }
    },
    {
      "name": "manage_expressions",
      "description": "List, get, set, or delete CEL expressions with unit validation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list", "get", "set", "delete"]
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "session_type": {
            "type": "string",
            "enum": ["auto", "pre", "post"]
          }
        }
      }
    },
    {
      "name": "inspect_mesh",
      "description": "Inspect mesh topology, element counts, bounding box, and domains",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "screenshot",
      "description": "Capture visual viewport, contour, or vector plot to base64 PNG",
      "inputSchema": {
        "type": "object",
        "properties": {
          "output_file": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
